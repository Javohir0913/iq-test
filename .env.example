# --- PostgreSQL ---
POSTGRES_DB=iqtest
POSTGRES_USER=iqtest
POSTGRES_PASSWORD=change-me-strong-password

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Admin panelga kirish (birinchi ishga tushishda yaratiladi)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-admin-password

# --- Test ---
TEST_DURATION_MINUTES=40

# --- Telegram bot va Mini App ---
# @BotFather dan olingan token (bo‘sh bo‘lsa bot kutish rejimida turadi)
TELEGRAM_BOT_TOKEN=
# Ixtiyoriy: bot username (bo‘sh bo‘lsa getMe orqali aniqlanadi)
TELEGRAM_BOT_USERNAME=
# Test yakunlanganda natijani bot chatiga yuborish
TELEGRAM_NOTIFY_RESULTS=true
# Domen bo‘lmasa: Cloudflare quick tunnel (bepul HTTPS). Domen bo‘lsa – qatorni o‘chirib, PUBLIC_URL=https://domen
COMPOSE_PROFILES=tunnel

# --- Umumiy ---
# Saytning tashqi manzili (CORS/CSRF, Telegram Mini App). Telegram uchun https:// bo‘lishi shart;
# http bo‘lsa va tunnel yoqilgan bo‘lsa, tunnel manzili avtomatik ishlatiladi.
PUBLIC_URL=http://localhost
# Nginx tashqi porti va manzili (serverda boshqa saytlar bo‘lsa: HTTP_BIND=127.0.0.1, HTTP_PORT=5183)
HTTP_BIND=0.0.0.0
HTTP_PORT=80
# Saytga kirish faqat Telegram orqali (bot token bo‘lmasa avtomatik o‘chadi)
REQUIRE_TELEGRAM_AUTH=true
# Backend oldidagi proxy'lar soni (mijoz IP'si uchun): to‘g‘ridan-to‘g‘ri = 1, host nginx yoki tunnel orqali = 2
NUM_PROXIES=1
# API so‘rovlar chegarasi (DRF throttling)
THROTTLE_ATTEMPT_CREATE=30/hour
